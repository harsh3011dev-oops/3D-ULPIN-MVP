# Backend API Base URL (Leave empty for local dev proxy '/api', or set your production backend URL)
VITE_API_BASE_URL=https://your-backend-api.onrender.com/api

# Google Maps Platform / Map Tiles API Key for Photorealistic 3D Tiles
# Get your key at: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Alternative API key aliases
# VITE_GOOGLE_3D_TILES_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
