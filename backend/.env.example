# ─────────────────────────────────────────────
# 3D-ULPIN Backend — Environment Variables
# Copy this to .env and fill in real values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# ── Supabase ──────────────────────────────────
SUPABASE_URL=https://rbnalegistofifvfgklj.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Database (Supabase PostgreSQL via Transaction Pooler) ──
# Format: postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.rbnalegistofifvfgklj:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Supabase Storage ──────────────────────────
SUPABASE_STORAGE_BUCKET=aerial-images

# ── App Settings ──────────────────────────────
SECRET_KEY=change-this-to-a-random-secret
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
